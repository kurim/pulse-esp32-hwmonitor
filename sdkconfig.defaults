# --- Flash / Partitionen ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Image-Groesse ---
# Das Image enthaelt Treiber fuer 5 Displaytypen gleichzeitig und ist dadurch
# deutlich groesser als der urspruengliche CYD-only-Build (bis zu ~1.6 MB je
# nach Zielchip) - Groessenoptimierung statt Geschwindigkeit, um Luft in den
# 1.75-MB-OTA-Partitionen zu behalten (siehe partitions.csv).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- FreeRTOS / Task-Stacks ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# --- HTTP-Server (Config-Portal + OTA) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# Hochgesetzt (Default 10): Handys pruefen im Setup-AP die Internet-
# verbindung ueber mehrere parallele Captive-Portal-Anfragen; mit dem
# Default gingen dem httpd-Server dabei die Sockets aus ("error in accept").
# web_portal.c setzt httpd_config_t.max_open_sockets passend dazu auf 13.
CONFIG_LWIP_MAX_SOCKETS=16

# --- LVGL (Display-UI) ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_ARC=y
# GC9A01-Rundlayout nutzt lv_arc; SSD1309-Minimal-UI kommt mit den bereits
# eingebundenen Montserrat-Fonts/Labels aus - keine weiteren Widgets noetig.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
